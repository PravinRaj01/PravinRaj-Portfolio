# Neon Postgres — pooled connection (PgBouncer, transaction mode) for the app
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname
# Neon Postgres — direct connection, used only by Alembic
DATABASE_URL_DIRECT=postgresql+asyncpg://user:password@ep-xxxx.region.aws.neon.tech/dbname

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gg-portfolio
R2_PUBLIC_BASE=https://assets.example.com

# Comma-separated exact origins allowed to call this API.
# Local dev:  http://localhost:5173,http://localhost:8080
# Production: https://pravinraj.dev,https://www.pravinraj.dev,https://pravin-raj-portfolio.vercel.app,https://gg-portfolio.lovable.app
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional regex for origins that can't be listed literally (Vercel preview
# deployments). Leave blank locally.
# Production: ^https://pravin-raj-portfolio-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=

# Set to "production" on the deployed backend to disable /docs, /redoc
# and /openapi.json.
ENVIRONMENT=development

# Turns on the three AI features: /ai/generate-description,
# /ai/generate-magazine and the public /ai/chat chatbot stream. Gemini is
# tried first, Groq is the fallback on a 429/5xx (or the only provider, if
# only GROQ_API_KEY is set). Both empty leaves those routes responding 503
# "AI service not configured". Both are free-tier keys, no card needed:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Model names are env vars (not hardcoded) so a renamed/retired free model
# can be swapped in Vercel's settings without a code change. These defaults
# are current free-tier models as of writing:
#   Gemini free models: https://ai.google.dev/gemini-api/docs/pricing
#   Groq free models:   https://console.groq.com/docs/models
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CONTENT_MODEL=gemini-3.8-flash
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_CONTENT_MODEL=openai/gpt-oss-120b

# Chatbot RAG (see RAG_MIGRATION_PLAN.md). When true, each chat message gets the
# owner's core profile plus the few portfolio chunks most relevant to the
# question (hybrid vector + full-text search in Postgres) instead of the whole
# portfolio -- ~1.5K tokens instead of 6-9K. Needs the portfolio_chunks table
# (alembic upgrade head) and an index (POST /api/v1/ai/reindex as admin).
# Embeddings are Gemini-only (Groq has none), so GEMINI_API_KEY is required.
# Anything going wrong at request time falls back to the full portfolio prompt;
# set this to false to switch RAG off entirely.
RAG_ENABLED=false
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=8
RAG_POOL=20
# Cosine floor on the vector branch only. Calibrated for gemini-embedding-001.
RAG_MIN_SCORE=0.55

# Chat guard: answers jailbreak attempts with a fixed redirect instead of
# searching and calling the LLM. Free: it reuses the embedding RAG already
# computes (so it needs RAG_ENABLED=true) and compares it to precomputed
# example vectors in app/services/chat_guard_index.json. Fails open: if that
# file is missing or stale it silently does nothing. Regenerate it after editing
# chat_guard_examples.py:  PYTHONPATH=. python scripts/build_chat_guard_index.py
# Thresholds come from:    PYTHONPATH=. python scripts/eval_chat_guard.py
CHAT_GUARD_ENABLED=false
CHAT_GUARD_INJECTION_MIN_SIM=0.55
CHAT_GUARD_INJECTION_MARGIN=0.09
# Off-topic blocking caught too little to be worth the risk; leave off.
CHAT_GUARD_OFFTOPIC_ENABLED=false
CHAT_GUARD_OFFTOPIC_MIN_SIM=0.55
CHAT_GUARD_OFFTOPIC_MARGIN=0.06

# Lets the chatbot take visitors to pages ("show me your React projects") by
# giving the model a navigate_to tool; the reply stream then carries an `action`
# event that the chat widget turns into a route change. Leave false until the
# frontend that handles those events is deployed.
CHAT_NAVIGATION_ENABLED=false

# Opik observability: traces every AI call (chatbot + admin tools) with
# per-step timings, token usage and guard/retrieval details. Sent over Opik's
# REST API (no SDK). Needs OPIK_ENABLED=true AND an API key; fails open, so
# a tracing problem never affects a request. Free cloud account:
# https://www.comet.com/site/products/opik/ -- the workspace name is in the
# breadcrumb at the top of the Opik UI, the API key in the user menu (top right).
# Don't leave OPIK_ENABLED or OPIK_FLUSH_TIMEOUT blank: an empty value is not a
# valid boolean/number and stops the backend from starting.
OPIK_ENABLED=false
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=gg-portfolio
# Only for a self-hosted Opik; leave it unset to use Comet's cloud.
# OPIK_URL=
OPIK_FLUSH_TIMEOUT=3

# Admin "Import from GitHub" (project drafts from a repository URL). Optional:
# without a token GitHub allows ~60 anonymous requests an hour (an import uses
# about 8) and public repos only. A fine-grained token with read-only access to
# repository contents/metadata raises that and allows your private repos.
GITHUB_TOKEN=

# Turns on the Google Drive browser: GET /drive/test, /drive/count, /drive/list
# (both ?folder_id= and ?folderId= are accepted). Public, read-only key from the
# Google Cloud Console -> APIs & Services -> Credentials, restricted to the
# Drive API. Leave blank to have those routes respond 503 "not configured".
GOOGLE_DRIVE_API_KEY=
