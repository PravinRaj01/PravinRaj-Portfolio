# Neon Postgres — pooled connection (PgBouncer, transaction mode) for the app
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname
# Neon Postgres — direct connection, used only by Alembic
DATABASE_URL_DIRECT=postgresql+asyncpg://user:password@ep-xxxx.region.aws.neon.tech/dbname

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gg-portfolio
R2_PUBLIC_BASE=https://assets.example.com

# Comma-separated exact origins allowed to call this API.
# Local dev:  http://localhost:5173,http://localhost:8080
# Production: https://pravinraj.dev,https://www.pravinraj.dev,https://pravin-raj-portfolio.vercel.app,https://gg-portfolio.lovable.app
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional regex for origins that can't be listed literally (Vercel preview
# deployments). Leave blank locally.
# Production: ^https://pravin-raj-portfolio-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=

# Set to "production" on the deployed backend to disable /docs, /redoc
# and /openapi.json.
ENVIRONMENT=development

# AI gateway for /ai/generate-description, /ai/generate-magazine, /ai/chat.
# Leave blank to have those routes respond 503 "AI service not configured".
LOVABLE_API_KEY=

# Public, read-only Drive API key for the /drive proxy (Google Cloud Console
# -> APIs & Services -> Credentials -> restrict to the Drive API).
GOOGLE_DRIVE_API_KEY=
